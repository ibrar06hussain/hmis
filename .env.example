APP_NAME="Cardiac Hospital Gilgit HMIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

HMIS_FACILITY_CODE=CHG
HMIS_FACILITY_NAME="Cardiac Hospital Gilgit"
HMIS_FACILITY_SHORT_NAME="CHG HMIS"
HMIS_FACILITY_REGION="Gilgit-Baltistan, Pakistan"
HMIS_DISPLAY_TIMEZONE=Asia/Karachi
HMIS_OFFLINE_LAN_MODE=true
HMIS_DEMO_MODE=false
HMIS_BREAK_GLASS_TTL_HOURS=4
HMIS_PACS_ENABLED=false
HMIS_AI_ENABLED=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Canonical production database: pgsql (PostgreSQL 16-18)
# Hostinger demo compatibility: mysql
# Local quick start / automated unit tests: sqlite
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=chg_hmis
# DB_USERNAME=hmis_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
